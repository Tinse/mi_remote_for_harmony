{
  "app": {
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        // 调试签名：本仓库不带任何签名配置。
        // 用 DevEco Studio 打开工程 -> File > Project Structure > Signing Configs 勾选
        // "Automatically generate signature"（需登录华为开发者账号），生成的
        // signingConfigs 会写回本文件；命令行 assembleHap 出的包为未签名包。
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "ime",
      "srcPath": "./ime",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "probecore",
      "srcPath": "./probecore"
    }
  ]
}
